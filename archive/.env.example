# Vector Database Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Embedding Configuration
# Options: "local" (free, fast), "openai" (slow, paid, better quality)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# If using OpenAI embeddings
OPENAI_API_KEY=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Frontend Configuration
FRONTEND_API_URL=http://localhost:8001

# Scraper Configuration
SCRAPER_TIMEOUT=30
SCRAPER_RETRIES=3
SCRAPER_BATCH_SIZE=50

# Data Processing
CHUNK_SIZE=512
CHUNK_OVERLAP=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Parallel Processing
NUM_WORKERS=4
